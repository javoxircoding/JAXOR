generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// FOYDALANUVCHI
model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique // ✨ FIX: Теперь phone может быть пустым при регистрации!
  password  String
  role      Role     @default(VENDOR)
  plan      Plan     @default(STARTER) // ✨ ДОБАВИЛИ: Чтобы тариф сохранялся сразу при регистрации
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store?
}

// DO'KON
// DO'KON
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float    // Для сумов сойдет, но помни про округления в JS
  stock       Int      @default(0)
  image       String?
  createdAt   DateTime @default(now())
  
  // 🔥 ДОБАВИЛИ: Автоматическое отслеживание изменений товара
  updatedAt   DateTime @updatedAt 

  storeId     String
  
  // FIX 2: Добавляем onDelete: Cascade к связи со Store
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Store {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // Используем для красивых ссылок jaxor.uz/store/slug
  type        String
  description String?
  address     String?
  logo        String?
  banner      String?
  plan        Plan      @default(STARTER)
  status      Status    @default(TRIAL)
  
  trialEndsAt DateTime  
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  ownerId     String    @unique
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  products    Product[]
  orders      Order[]
  subdomain   String?   @unique // ✨ FIX: Сделали опциональным (добавили ?), чтобы база не падала, если поддомен еще не настроен
  payments    Payment[]
}

// BUYURTMA
model Order {
  id        String      @id @default(cuid())
  status    OrderStatus @default(NEW)
  total     Float
  createdAt DateTime    @default(now())
  storeId   String
  
  // FIX 3: Добавляем onDelete: Cascade к связи со Store, чтобы старые заказы не оставались сиротами
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum Role {
  VENDOR
  SUPER_ADMIN
}

enum Plan {
  STARTER
  STANDART
  PRO
}

enum Status {
  TRIAL
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  NEW
  PREPARING
  DELIVERY
  DONE
  CANCELLED
}

// TO'LOVLAR TARIXI
model Payment {
  id        String        @id @default(cuid())
  amount    Float         // To'lov summasi (masalan: 300000)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  storeId   String
  // Тут у тебя уже стоял Cascade — это супер!
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}